  "baseline_adr": "docs/architecture/ADR-001-FINAL-STACK.md",
  "design_contract": {
    "api": "HTTPS /v1/tenants/{tenantId}/<resource> JSON; OpenAPI versioned; tenant derived from authenticated session and checked against resource",
    "outbox": "commit business state + immutable outbox record in same database transaction; at-least-once dispatch; consumer de-dup by unique event id; no external delivery in original DB transaction",
    "security": "transaction-local actor and tenant; tto_app non-owner NOBYPASSRLS; FORCE RLS as appropriate, deny by default; security-definer reviewed, path fixed",
    "secrets": "no credentials in repo/browser/logs; per-environment secret manager; rotation and masked CI; deny absent env",
    "storage": "S3-compatible abstraction, content hash, scan result, classification and legal hold, signed download grant, no raw object URLs",
    "broker": "outbox required; Redis/BullMQ optional only after measured need",
    "preview": "Vercel protected synthetic preview only if eligibility/SSO/private repo authorized; not production",
    "production": "ArvanCloud only after separate approval, no live data activated by design contract",
    "payment": "buyer to seller direct; verification separate from reported, no internal wallet/custody, no transfer inferred"
  },
